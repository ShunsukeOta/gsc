# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32文字以上のランダム文字列。OAuth token cookieの暗号化キーに使用します。
GSC_SESSION_SECRET=

# 任意。未指定時はアクセス中のorigin + /api/auth/google/callback を使用します。
# 本番ではGoogle Cloud Consoleに登録したURIと完全一致させてください。
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Search Console API settings
# all: fresh/incomplete dataを含む / final: 確定データのみ
GSC_DATA_STATE=all

# 同一条件の分析結果をサーバー側でキャッシュする秒数
GSC_CACHE_TTL_SECONDS=300

# query/page/query×pageで取得する最大行数。APIの1リクエスト上限25,000を超える場合はページングします。
GSC_MAX_ROWS=25000
